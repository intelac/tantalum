# build output
target/
console/dist/
console/node_modules/
console/test-results/
console/playwright-report/

# local runtime data (journal, sqlite, logs)
data/
*.db
*.db-wal
*.db-shm
*.log
audit.log

# browser automation scratch
.playwright-mcp/

# secrets: API keys are read only from the environment, never from files in this repo
.env
.env.*
*.key

# editors / os
.idea/
.vscode/
*.iml
.DS_Store

# typescript incremental build cache
*.tsbuildinfo

# spec-workflow tool state: approvals, per-task implementation logs, default templates (specs, steering, reviews and BACKLOG stay tracked)
.spec-workflow/approvals/
.spec-workflow/specs/*/Implementation Logs/
.spec-workflow/templates/
.spec-workflow/user-templates/
.spec-workflow/reviews/

# spec-workflow and code-review tooling stay local
.spec-workflow/
.opencodereview/
