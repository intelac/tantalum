<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.tantalum</groupId>
    <artifactId>tantalum</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- 连接程序：在用户的电脑上运行，主动连到服务器，在允许的目录里执行工具。运行时只依赖 tantalum-local 和 JDK。 -->
  <artifactId>tantalum-connect</artifactId>

  <dependencies>
    <dependency>
      <groupId>dev.tantalum</groupId>
      <artifactId>tantalum-local</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 只给 LinkIT：同一个 JVM 里起真的服务器。 -->
    <dependency>
      <groupId>dev.tantalum</groupId>
      <artifactId>tantalum-shell</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.tantalum</groupId>
      <artifactId>tantalum-shell</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>tantalum.connect.Main</mainClass>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- LinkIT 起真的服务器和连接程序，有重连和到期的等待，放在 integration-test 阶段跑。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
          <properties>
            <configurationParameters>junit.jupiter.execution.timeout.default = 60 s
            junit.jupiter.execution.timeout.thread.mode.default = SEPARATE_THREAD</configurationParameters>
          </properties>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      macOS（Apple 芯片）安装包（local-workspace 任务 22）：自带 jlink 裁剪的运行环境和 MXC 的 Tantalum Connect.app，打成 zip。
        mvn -o -pl tantalum-connect -am package -Pmac -DskipTests
      产物 target/tantalum-connect-<版本>-macos-arm64.zip。MXC 的发布包缓存在 ~/.cache/tantalum/mxc/1.0.1，构建时校验 SHA-256，
      不进 Git 仓库；离线构建时可用环境变量 MXC_ZIP 指向已下载的 mxc-release-binaries.zip。细节见 src/package/build-mac.sh。
    -->
    <profile>
      <id>mac</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>package-input</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <overWriteSnapshots>true</overWriteSnapshots>
                  <outputDirectory>${project.build.directory}/package/input</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>build-mac</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.basedir}/src/package/build-mac.sh</executable>
                  <arguments>
                    <argument>${project.build.directory}</argument>
                    <argument>${project.version}</argument>
                    <argument>${project.build.finalName}.jar</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
