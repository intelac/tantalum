<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.tantalum</groupId>
    <artifactId>tantalum</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tantalum-examples</artifactId>

  <dependencies>
    <dependency>
      <groupId>dev.tantalum</groupId>
      <artifactId>tantalum-shell</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tantalum</groupId>
      <artifactId>tantalum-shell</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- 端到端测试从这里取连接程序的类路径，起一个真的 tantalum-connect 进程（local-workspace 任务 19）。 -->
    <dependency>
      <groupId>dev.tantalum</groupId>
      <artifactId>tantalum-connect</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.5.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- *IT 测试启动打包好的 jar，只在 integration-test 阶段跑：那时 tantalum-shell 的 jar 已经打好。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <tantalum.jar>${project.basedir}/../tantalum-shell/target/tantalum-shell-${project.version}-exec.jar</tantalum.jar>
            <!-- 示例插件的 jar（只有示例插件和自动配置），ExamplesJarIT 用 loader.path 加载它 -->
            <tantalum.examples.jar>${project.build.directory}/${project.build.finalName}.jar</tantalum.examples.jar>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 端到端测试的后端：mvn -P e2e -pl tantalum-examples -am -DskipTests test-compile
         在编译完测试代码后启动 E2eServer（脚本化模型，固定端口），由 console/playwright.config.ts 调用。 -->
    <profile>
      <id>e2e</id>
      <properties>
        <tantalum.e2e.port>8097</tantalum.e2e.port>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>e2e-server</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>tantalum.examples.E2eServer</mainClass>
                  <classpathScope>test</classpathScope>
                  <arguments>
                    <argument>${tantalum.e2e.port}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- 性能基准，发布前手动跑：mvn -P bench -pl tantalum-examples -am -DskipTests test-compile
         每个样本一个新进程，不随普通构建运行。 -->
    <profile>
      <id>bench</id>
      <properties>
        <bench.main>tantalum.examples.bench.ReadBench</bench.main>
        <bench.sizes>10000,100000,500000</bench.sizes>
        <bench.samples>3</bench.samples>
        <!-- 只能收紧（0 到 1），用来确认超预算时 bench 失败；预算本身在 Budgets.java。 -->
        <bench.tighten>1</bench.tighten>
        <!-- LaneBench 的对照实验：先预热再计时。 -->
        <lane.warmup>false</lane.warmup>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>bench</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>java</executable>
                  <classpathScope>test</classpathScope>
                  <arguments>
                    <argument>-Xmx4g</argument>
                    <argument>--enable-native-access=ALL-UNNAMED</argument>
                    <argument>-Dbench.tighten=${bench.tighten}</argument>
                    <argument>-Dlane.warmup=${lane.warmup}</argument>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>${bench.main}</argument>
                    <argument>${project.build.directory}/bench</argument>
                    <argument>${bench.sizes}</argument>
                    <argument>${bench.samples}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
